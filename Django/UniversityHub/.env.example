# Backend environment variables (copy to .env or set in the host dashboard)
#
# Never commit real secrets. This file documents what is required.

# Django
SECRET_KEY=replace-with-a-long-random-string
DEBUG=False

# Comma-separated list of allowed hostnames.
# Render adds RENDER_EXTERNAL_HOSTNAME automatically.
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Neon / any Postgres). Leave unset to use local SQLite.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Origins allowed to call the API (the deployed React app).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional regex for Vercel preview URLs.
# CORS_ALLOWED_ORIGIN_REGEXES=^https://your-project-.*\.vercel\.app$

# Django admin CSRF trust (the backend's own https origin).
CSRF_TRUSTED_ORIGINS=https://your-backend.onrender.com

# Optional: create an admin user automatically during the Render build.
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=change-me
